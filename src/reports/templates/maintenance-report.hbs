<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <title>{{title}}</title>
  </head>

  <body>
    <h1>{{title}}</h1>

    <p>
      <strong>Maintenance Record ID:</strong>
      {{maintenanceId}}
    </p>

    <h2>Equipment</h2>

    <p>
      <strong>Name:</strong>
      {{equipmentName}}
    </p>

    <p>
      <strong>Serial number:</strong>
      {{equipmentSerialNumber}}
    </p>

    <p>
      <strong>Type:</strong>
      {{equipmentType}}
    </p>

    <h2>Maintenance Details</h2>

    <p>
      <strong>Performed at:</strong>
      {{performedAt}}
    </p>

    <p>
      <strong>Maintenance interval:</strong>
      {{intervalMonths}}
      months
    </p>

    <p>
      <strong>Next maintenance:</strong>
      {{nextMaintenanceAt}}
    </p>

    {{#if notes}}
      <h2>Notes</h2>
      <p>{{notes}}</p>
    {{/if}}
  </body>
</html>